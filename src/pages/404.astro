---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Pagina no encontrada (404)" description="La pagina que buscas no existe o ha sido movida.">

  <section class="max-w-3xl mx-auto px-4 py-28 sm:py-36 text-center">
    <p class="text-blue-400 font-mono text-sm tracking-widest uppercase mb-4">Error 404</p>
    <h1 class="text-4xl sm:text-5xl font-bold text-white leading-tight">
      Pagina no encontrada
    </h1>
    <p class="mt-6 text-lg text-gray-400 max-w-xl mx-auto leading-relaxed">
      La pagina que buscas no existe o ha sido movida. Comprueba la direccion
      o vuelve al catalogo de fuentes.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/" class="px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg transition">
        Volver al inicio
      </a>
      <a href="/fuentes/" class="px-6 py-3 bg-gray-800 hover:bg-gray-700 text-gray-200 font-semibold rounded-lg border border-gray-700 transition">
        Ver fuentes de datos
      </a>
    </div>
  </section>

</Layout>
